# --- Trading mode (paper ONLY; live stays disabled) ---
TRADING_MODE=paper
ENABLE_PAPER_ORDERS=false
ENABLE_LIVE_TRADING=false

# --- Alpaca paper credentials (never commit real values) ---
# Primary names; APCA_API_KEY / APCA_API_SECRET / APCA_PAPER1_* aliases also accepted.
# NOTE: use the bare host (no trailing /v2); a trailing /v2 is stripped automatically.
ALPACA_API_KEY=
ALPACA_API_SECRET=
ALPACA_PAPER_BASE_URL=https://paper-api.alpaca.markets

# --- Market data ---
# CRYPTO_SYMBOLS=ALL uses all 33 USD-quoted Alpaca crypto pairs (verified list in
# trader/core/config.py FULL_USD_UNIVERSE; USDC/USDT/BTC-quoted pairs excluded to keep P&L in USD).
CRYPTO_SYMBOLS=BTC/USD,ETH/USD,SOL/USD
PRIMARY_TIMEFRAME=15Min
DATA_CACHE_TTL_SECONDS=300
DATA_CACHE_MAX_ENTRIES=500
DATA_PROVIDER=alpaca

# --- Muse AI (optional decision support; fail-closed) ---
CLAUDE_ENABLED=false
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-sonnet-4-5
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_TIMEOUT_SECONDS=15
CLAUDE_MAX_TOKENS=1024

# --- Risk (defaults; override per deployment) ---
MAX_ORDER_NOTIONAL=500
MAX_POSITION_NOTIONAL=2000
MAX_PORTFOLIO_EXPOSURE=5000
MAX_CONCENTRATION_PCT=0.5
MAX_DAILY_LOSS=300
MAX_DRAWDOWN_PCT=0.15
MAX_OPEN_ORDERS=10
MIN_BUYING_POWER=100
MAX_TURNOVER_PCT=1.0
STALE_DATA_SECONDS=900

# --- Backtest ---
BACKTEST_FEE_PCT=0.0025
BACKTEST_SLIPPAGE_PCT=0.0005

# --- Broker read latency bound (seconds) ---
# alpaca-py never passes a timeout to requests.Session, so a hung broker
# connection could block an API request thread indefinitely. READ-ONLY broker
# calls (account, positions, assets) are abandoned after this many seconds and
# the dashboard degrades gracefully. Order submission is NOT bounded this way.
BROKER_READ_TIMEOUT_SECONDS=10

# --- Dashboard ---
API_HOST=127.0.0.1
API_PORT=8000
DASHBOARD_PASSWORD=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
# Set true ONLY behind a trusted edge proxy that appends the client address
# (Railway). Leaving it false prevents X-Forwarded-For spoofing from bypassing
# the password rate limit, at the cost of all clients sharing one bucket.
TRUST_PROXY_HEADERS=false

# --- Durability (production / Railway) ---
# REQUIRE_DURABLE_STORE=true makes the service REFUSE TO START unless
# DATABASE_URL is set and the PostgreSQL connection succeeds. Use it on Railway
# so order/signal state is never silently kept in ephemeral in-memory storage.
# Locally keep it false (or unset) to allow the in-memory fallback.
# Production (Railway) MUST set this to true.
REQUIRE_DURABLE_STORE=false

# --- Automation (OFF by default; dry-run default true = logs only, no orders) ---
AUTOMATE_ENABLED=false
AUTOMATE_INTERVAL_MINUTES=15
AUTOMATE_MIN_CONFIDENCE=0.5
AUTOMATE_MAX_NOTIONAL=100
AUTOMATE_DRY_RUN=true

# --- Neon PostgreSQL (durable source of truth: signals, backtests, orders) ---
# Primary store. Copy the *pooled* connection string from the Neon console
# (Connect > Connection pooling). Never commit real credentials.
# The pooler host is IPv4-reachable, which Railway requires.
#   postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# sslmode=require is enforced automatically for non-local hosts when omitted.
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
# Optional direct (unpooled) URL: used only for migrations/admin tooling.
DATABASE_URL_UNPOOLED=
# Numeric Neon project/branch identifiers are optional metadata for dashboards.
NEON_PROJECT_ID=
NEON_BRANCH=production

# Connection safety (see docs/DEPLOYMENT_NEON.md)
DB_CONNECT_TIMEOUT=5
DB_CONNECT_RETRIES=3
DB_SSLMODE=require
DB_APPLICATION_NAME=finrl-trader

# Legacy: the previous Supabase database. Kept commented as a rollback path.
# Do not delete or overwrite the Supabase project; see docs/DEPLOYMENT_NEON.md.
# DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- Redis (local cache; configure for another Redis service later) ---
REDIS_URL=redis://localhost:6379/0
